#!/usr/bin/env bash
#MISE description="Cargo runner for x86_64-unknown-none (see .cargo/config.toml)"
#MISE hide=true
#MISE depends=["build:init", "build:fixtures", "setup:ovmf"]
#USAGE arg "<exe>" help="Executable built by Cargo"
#USAGE arg "[args]..." var=#true help="Test filters, ignored by the kernel test runner"
# `cargo run` passes the kernel. `cargo test` passes a hashed test executable such as
# kernel-0123abcd. Pass either path directly to the image writer.
set -euo pipefail
# shellcheck source=../lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

exe=${1:?expected the executable built by Cargo}
if [[ ${exe##*/} == kernel ]]; then
    cargo xtask image "$exe" >/dev/null
    exec "$tasks/run/_default"
fi
cargo xtask image --test "$exe" >/dev/null
exec cargo xtask test-qemu

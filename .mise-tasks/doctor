#!/usr/bin/env bash
#MISE description="Check native build and test prerequisites"
set -u

missing=0
for tool in cargo rustc cc qemu-system-x86_64 shellcheck; do
    if ! command -v "$tool" >/dev/null; then
        echo "Missing $tool (see README.md)" >&2
        missing=1
    fi
done
exit "$missing"

#!/usr/bin/env bash
#MISE description="Check native build and test prerequisites"
set -u

missing=0
# Pass when any of the given commands exists.
need() {
    local tool
    for tool in "$@"; do
        command -v "$tool" >/dev/null && return
    done
    echo "Missing $(printf '%s or ' "$@" | sed 's/ or $//') (see README.md)" >&2
    missing=1
}

for tool in cargo rustc cc curl tar sgdisk mcopy mmd mformat qemu-system-x86_64 shellcheck; do
    need "$tool"
done
need timeout gtimeout
need sha256sum shasum
exit "$missing"

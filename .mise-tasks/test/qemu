#!/usr/bin/env bash
#MISE description="Build the test image and run guest tests in QEMU"
#MISE depends=["image:test", "setup:ovmf"]
set -euo pipefail
# shellcheck source=../lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

timer=timeout
command -v timeout >/dev/null || timer=gtimeout
code=0
# On success the test runner writes 0x10 to the isa-debug-exit port, and QEMU exits with (0x10 << 1) | 1 = 33.
"$timer" -k 5 120 "${qemu_uefi[@]}" -drive "$(nvme_drive "$test_image")" \
    -display none -device isa-debug-exit,iobase=0xf4,iosize=0x04 || code=$?
if [[ $code != 33 ]]; then
    echo "QEMU returned $code (expected 33)" >&2
    exit 1
fi
